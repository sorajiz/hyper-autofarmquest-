# Token tài khoản Discord User để cày Quest (Bắt buộc)
TOKEN=your_discord_token_here

# Discord Remote Controller Bot Credentials (Tùy chọn)
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_BOT_ID=1552658898937446400
ADMIN_USER_ID=

# Proxy Pool (Tùy chọn - HTTP, HTTPS, SOCKS5 phân cách bởi dấu phẩy)
PROXIES=
PROXY=

# Captcha Solvers (Tùy chọn)
CAPSOLVER_API_KEY=
TWOCAPTCHA_API_KEY=

# Tự động hóa nhiệm vụ
AUTO_ENROLL=true
AUTO_CLAIM=true
HEARTBEAT_INTERVAL=30
PLAY_SOUND=true
